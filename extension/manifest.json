{
  "manifest_version": 3,
  "name": "Flow Bridge",
  "version": "0.1.10",
  "version_name": "0.1.10",
  "minimum_chrome_version": "116",
  "description": "Connect Frame Studio to your Google Flow workspace. Explicit local pairing. No password or cookie access.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "https://flow.google.com/*", "https://labs.google/fx/tools/flow*", "https://labs.google/fx/*/tools/flow*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Flow Bridge — connect Google Flow", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*" }
}

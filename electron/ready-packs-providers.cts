 }catch(e){signal.throwIfAborted();reject(diagnostics,'resolution',e instanceof Error?e.message:'Resolution failed.',host)}
 }}if(diagnostics)diagnostics.counts.resolvedRetailerUrls=pool.size;return[...pool.values()].slice(0,20)

export function retailerAnchors(html:string,base:string):PackProduct[] {
 const found=new Map<string,PackProduct>();for(const match of html.matchAll(/<a\b[^>]*href\s*=\s*["']([^"']+)["']/gi)){try{const url=new URL(match[1].replace(/&amp;/g,'&').replace(/&#38;/g,'&'),base).href;const p=candidate(url);found.set(p.id,p)}catch{/* Public retailer detail anchors only; scripts are not executed. */}}return[...found.values()].slice(0,8)
}
async function descriptionListing(raw:string,signal:AbortSignal,d?:DiscoveryDiagnostics):Promise<PackProduct[]>{
 let url=raw;for(let hop=0;hop<5;hop++){
 try{return[candidate(url)]}catch{/* Resolve only documented/common description short-link hosts. */}
 const host=new URL(url).hostname;if(hop===0&&!['meesho.onelink.me','affiliate.meesho.com','fktr.in','fkrt.cc','fkrt.it','dl.flipkart.com','amzn.in','amzn.to','myntr.it','myntr.in','bit.ly','tinyurl.com','wishlink.com','ekaro.in','cuelinks.com'].some(h=>host===h||host.endsWith('.'+h))){reject(d,'resolution','URL host is not a supported retailer or known short-link provider.',host);return[]}
 const r=await fetch(await publicTarget(url),{redirect:'manual',signal:AbortSignal.any([signal,AbortSignal.timeout(10000)])});const next=r.headers.get('location');
 if(r.status>=300&&r.status<400&&next){await r.body?.cancel();url=new URL(next,url).href;continue}
 if(!r.ok){await r.body?.cancel();reject(d,'resolution',`Link provider HTTP ${r.status}; access restriction respected.`,host);return[]}
 if(!r.headers.get('content-type')?.includes('text/html')){await r.body?.cancel();reject(d,'resolution','Link provider returned no redirect and no HTML anchors.',host);return[]}
 const reader=r.body!.getReader();const chunks:Uint8Array[]=[];let size=0;try{while(true){const p=await reader.read();if(p.done)break;size+=p.value.length;if(size>1_000_000)throw new Error('Link page exceeds 1 MB inspection limit.');chunks.push(p.value)}}finally{await reader.cancel()}
 const products=retailerAnchors(Buffer.concat(chunks).toString('utf8'),url);if(!products.length)reject(d,'resolution','HTTP 200 HTML contains no supported retailer product anchors; JavaScript is not executed.',host);return products
 }reject(d,'resolution','Five redirect hops exhausted.',new URL(url).hostname);return[]
}
export function youtubeProvider(key:string,diagnostics?:DiscoveryDiagnostics):Provider {

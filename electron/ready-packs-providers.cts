 try{let products:PackProduct[]=[];try{products=[candidate(cleaned)]}catch{if(!resolved.has(cleaned)){if(resolutionBudget<=0){reject(diagnostics,'resolution','Short-link resolution budget exhausted.',host);continue}resolutionBudget--;resolved.set(cleaned,await descriptionListing(cleaned,signal,diagnostics))}products=resolved.get(cleaned)??[]}
 if(!products.length)continue;for(const p of products){

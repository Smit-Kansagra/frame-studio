export async function listingDetails(p:PackProduct,signal:AbortSignal,diagnostics?:DiscoveryDiagnostics):Promise<PackProduct> {
 if(p.retailer==='libas')throw new Error('Libas details require the merchant-authorised provider.');const response=await bytes(p.url,signal);if(diagnostics)diagnostics.counts.accessibleListings++;if(!response.type.includes('html'))throw new Error('Listing did not return HTML.')

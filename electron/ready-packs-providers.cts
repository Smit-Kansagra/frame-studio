 async function api(endpoint:string,params:Record<string,string>){const u=new URL('https://www.googleapis.com/youtube/v3/'+endpoint);Object.entries({...params,key}).forEach(([k,v])=>u.searchParams.set(k,v));const r=await fetch(u,{redirect:'error',signal:AbortSignal.any([signal,AbortSignal.timeout(20000)])});if(!r.ok)throw new Error(`YouTube API HTTP ${r.status}; check key and quota.`);return r.json()}
 const search=await api('search',{part:'snippet',type:'video',q:'women '+sub+' India haul',maxResults:'10',publishedAfter:diagnostics?.windowStart??new Date(Date.now()-14*86400000).toISOString()});

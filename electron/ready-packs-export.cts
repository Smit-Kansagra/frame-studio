import { applyLicences } from './ready-packs-licences.cjs'
import type { ProviderLicence } from './ready-packs-licences.cjs'
import sharp from 'sharp'
import { bytes } from './product-network.cjs'
import type { PackProduct, ReadyPack } from './ready-packs-types.cjs'
import { canonical, reviewable } from './ready-packs-core.cjs'
export const csvCell=(value:unknown)=>'"'+String(value??'').replace(/^[\s]*[=+@-]/,"'$&").replace(/"/g,'""')+'"'
const html=(value:unknown)=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!))
export function manifest(pack:ReadyPack,products:PackProduct[]) {return{schema:'frame-studio-ready-pack/v1',pack,products:pack.productIds.map((id,i)=>{const p=products.find(p=>p.id===id);if(!p)throw new Error('Pack product missing.');return{...p,number:i+1,primaryFile:`${String(i+1).padStart(2,'0')}_primary.jpg`,detailFiles:p.images.slice(1).map((_,j)=>`${String(i+1).padStart(2,'0')}_detail_${String(j+1).padStart(2,'0')}.jpg`)}})}}
export function textEntries(pack:ReadyPack,products:PackProduct[]):{name:string;data:Buffer}[] {
 const data=manifest(pack,products);const headers=['number','primaryFile','detailFiles','id','title','retailer','variant','url','affiliateUrl','price','currency','observedAt'];const csv=[headers.map(csvCell).join(','),...data.products.map(p=>headers.map(k=>csvCell((p as any)[k])).join(','))].join('\r\n')
 const preview='<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src \'none\'; img-src \'self\'; style-src \'unsafe-inline\'"><title>'+html(pack.theme)+'</title><style>body{font:16px system-ui;max-width:960px;margin:30px auto}article{display:inline-block;width:280px;padding:16px;vertical-align:top}img{width:100%;height:300px;object-fit:contain}</style></head><body><h1>'+html(pack.theme)+'</h1>'+data.products.map(p=>'<article><img src="'+p.primaryFile+'" alt="'+html(p.title)+'"><h2>'+p.number+'. '+html(p.title)+'</h2><p>'+html(p.variant)+' · '+html(p.currency)+' '+html(p.price)+'</p><a rel="noreferrer" href="'+html(p.url)+'">Original listing</a><p>Observed: '+html(p.observedAt)+'; stock: '+html(p.stock)+'</p></article>').join('')+'</body></html>'
 return[{name:'links.csv',data:Buffer.from('\uFEFF'+csv)},{name:'pack.json',data:Buffer.from(JSON.stringify(data,null,2))},{name:'preview.html',data:Buffer.from(preview)}]
}
function crc32(data:Buffer){let crc=0xffffffff;for(const byte of data){crc^=byte;for(let j=0;j<8;j++)crc=(crc>>>1)^((crc&1)?0xedb88320:0)}return(crc^0xffffffff)>>>0}
// Stored ZIP entries avoid platform tools and preserve the exact numbered mapping.
export function zip(entries:{name:string;data:Buffer}[]):Buffer {
 const local:Buffer[]=[],central:Buffer[]=[];let offset=0
 for(const entry of entries){if(!/^[a-zA-Z0-9_.-]+$/.test(entry.name))throw new Error('Unsafe ZIP filename.');const name=Buffer.from(entry.name),header=Buffer.alloc(30),directory=Buffer.alloc(46),crc=crc32(entry.data);header.writeUInt32LE(0x04034b50);header.writeUInt16LE(20,4);header.writeUInt32LE(crc,14);header.writeUInt32LE(entry.data.length,18);header.writeUInt32LE(entry.data.length,22);header.writeUInt16LE(name.length,26);directory.writeUInt32LE(0x02014b50);directory.writeUInt16LE(20,4);directory.writeUInt16LE(20,6);directory.writeUInt32LE(crc,16);directory.writeUInt32LE(entry.data.length,20);directory.writeUInt32LE(entry.data.length,24);directory.writeUInt16LE(name.length,28);directory.writeUInt32LE(offset,42);local.push(header,name,entry.data);central.push(directory,name);offset+=header.length+name.length+entry.data.length}
 const end=Buffer.alloc(22),centralBuffer=Buffer.concat(central);end.writeUInt32LE(0x06054b50);end.writeUInt16LE(entries.length,8);end.writeUInt16LE(entries.length,10);end.writeUInt32LE(centralBuffer.length,12);end.writeUInt32LE(offset,16);return Buffer.concat([...local,centralBuffer,end])
}
export async function exportZip(pack:ReadyPack,products:PackProduct[],download=bytes,licences:ProviderLicence[]=[]):Promise<Buffer> {
 if(!pack.productIds.length)throw new Error('This incomplete pack contains no qualifying products.')
 products=products.map(p=>applyLicences(structuredClone(p),licences));const data=manifest(pack,products),entries=textEntries(pack,products);let total=0
 for(const p of data.products){if(!p.observedAt||Date.now()-Date.parse(p.observedAt)>6*3600000||p.failures.some(f=>f.startsWith('Revalidation failed:')))throw new Error('Price/availability revalidation failed or remains stale. Inspect evidence before exporting.');if(!reviewable(p,pack))throw new Error('A product no longer meets pack filters. Replace it before export.');if(p.match!=='exact'||!p.images.length||p.images.some(i=>i.permission!=='permitted'||!i.permissionNote.trim()||i.variant!==p.variant||canonical(i.source,p.catalogue).id!==p.id))throw new Error('Photo download needs matching product images and recorded reuse permission. Manage permissions in Settings / Product Find Advanced.');for(let j=0;j<p.images.length;j++){const r=await download(p.images[j].url,AbortSignal.timeout(25000),15_000_000);if(!r.type.startsWith('image/'))throw new Error('Source did not return an image.');const jpeg=await sharp(r.data,{limitInputPixels:40_000_000}).rotate().flatten({background:'#ffffff'}).jpeg({quality:95}).toBuffer();total+=jpeg.length;if(total>90_000_000)throw new Error('Pack exceeds 90 MB export limit.');entries.push({name:j===0?p.primaryFile:p.detailFiles[j-1],data:jpeg})}}
 return zip(entries)
}

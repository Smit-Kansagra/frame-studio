import { commissionEstimate } from './ready-packs-ai.cjs'
import type { PackAdvice, PlanSlot } from './ready-packs-types.cjs'
import { applyLicences } from './ready-packs-licences.cjs'
import { reject } from './ready-packs-diagnostics.cjs'
import { PackRepository, assemble, eligible, selectProducts, validateSettings, planSeventhSlot } from './ready-packs-core.cjs'
import { classify, importProducts, listingDetails } from './ready-packs-providers.cjs'
import type { Provider } from './ready-packs-providers.cjs'
import type { PackStore, PackProduct, Performance, ReadyPack } from './ready-packs-types.cjs'
import { publicHttps } from './product-find-data.cjs'
export class PackService {
 state!:PackStore
 private active:AbortController|null=null
 private locked=false
 private cache=new Map<string,{at:number;products:PackProduct[]}>()
 readonly ready:Promise<void>
 constructor(readonly repository:PackRepository,private providers:()=>Promise<Provider[]>,private reasoning?:(store:PackStore,slot:PlanSlot,signal:AbortSignal)=>Promise<PackAdvice|null>) {this.ready=this.repository.load().then(s=>{this.state=s})}
 get busy(){return this.locked||!!this.active}
 async status(){await this.ready;this.state.providers=(await this.providers()).map(p=>p.status);for(const p of this.state.products){applyLicences(p,this.state.licences??[]);p.commissionEstimateInr=commissionEstimate(p)}return structuredClone(this.state)}
 async mutate(work:()=>Promise<void>){await this.ready;if(this.busy)throw new Error('A pack job is running. Cancel or wait before editing.');this.locked=true;const before=structuredClone(this.state);try{await work();await this.repository.save(this.state)}catch(e){this.state=before;throw e}finally{this.locked=false}}
 cancel(){this.active?.abort()}
 async tick(){await this.ready;if(!this.busy&&this.state.settings.scheduled&&this.state.job.attempts<3&&Date.parse(this.state.job.dueAt)<=Date.now()&&this.queue().length<3)await this.generate(false)}
 queue(){return this.state.packs.filter(p=>p.state==='drafted'||p.state==='exported')}
 pack(id:string){const p=this.state.packs.find(p=>p.id===id);if(!p)throw new Error('Pack not found.');return p}
 async generate(manual=true){await this.ready;if(this.busy)throw new Error('A pack job is running.');if(this.queue().length>=3)throw new Error('Three unconsumed packs already prepared. Post or skip one first.');const abort=new AbortController();if(manual)this.state.job.attempts=0;this.active=abort;this.state.job.state='running';this.state.job.message='Collecting bounded candidate pools…';await this.repository.save(this.state).catch(e=>{this.active=null;throw e});void this.collect(abort).finally(()=>{this.active=null})}
 private merge(rows:PackProduct[]){for(const p of rows){const index=this.state.products.findIndex(x=>x.id===p.id);if(index<0)this.state.products.push(p);else{const old=this.state.products[index];this.state.products[index]={...p,state:old.state,lastUsedAt:old.lastUsedAt,evidence:[...old.evidence,...p.evidence].slice(-30)}}}}
 private async collect(abort:AbortController){const signal=AbortSignal.any([abort.signal,AbortSignal.timeout(180000)]);try{
 const providers=await this.providers();if(!providers.some(p=>p.search)&&!this.state.products.length)throw new Error('Discovery blocked. Configure Flipkart affiliate access or YouTube Data API v3. Imports remain available.')
 while(this.queue().length<3){signal.throwIfAborted();const slot=this.state.plan.find(s=>s.state==='pending');if(!slot){this.state.job.message='Eight-week plan complete. Review coverage before starting another plan.';break}planSeventhSlot(this.state,slot);const category=this.state.settings.categories.find(c=>c.id===slot.category);if(!category){slot.state='deferred';slot.reason='Category removed from settings.';continue}if(category.deferred){slot.state='deferred';slot.reason=category.deferred;continue}
 this.state.diagnostics=providers.flatMap(p=>p.diagnostics?[p.diagnostics]:[]);const pool:PackProduct[]=[];const errors:string[]=[];for(const provider of providers.filter(p=>p.search)){try{const query=[slot.subcategory,this.state.settings.season==='All seasons'?'':this.state.settings.season,this.state.settings.occasion==='Everyday'?'':this.state.settings.occasion].filter(Boolean).join(' ');const key=provider.status.id+':'+query;const cached=this.cache.get(key);const rows=cached&&Date.now()-cached.at<6*3600000?structuredClone(cached.products):await provider.search!(category,query,signal);this.cache.set(key,{at:Date.now(),products:structuredClone(rows)});if(this.cache.size>60)this.cache.delete(this.cache.keys().next().value!);pool.push(...rows)}catch(e){signal.throwIfAborted();errors.push(provider.status.id+': '+(e as Error).message)}}
 if(!pool.length&&errors.length&&!this.state.products.length)throw new Error(errors.join(' '))
 const unique=[...new Map(pool.map(p=>[p.id,p])).values()].slice(0,30)
 for(let p of unique){signal.throwIfAborted();this.state.job.message='Verifying original listing facts: '+slot.subcategory;try{if(p.match!=='exact'&&p.retailer!=='libas')p=await listingDetails(p,signal,providers.find(x=>x.status.id==='youtube')?.diagnostics)}catch(e){signal.throwIfAborted();p.failures.push((e as Error).message);reject(providers.find(x=>x.status.id==='youtube')?.diagnostics,'listing',(e as Error).message,new URL(p.url).hostname)}classify(p,this.state.settings.categories);applyLicences(p,this.state.licences??[]);for(const d of providers.flatMap(x=>x.diagnostics?[x.diagnostics]:[])){if(p.evidence.some(e=>e.kind==='video')&&d.query.startsWith('Libas'))continue;if(!p.evidence.some(e=>e.kind==='video')&&d.query.startsWith('YouTube'))continue;const categoryMatch=p.category===category.id&&p.subcategory===slot.subcategory;if(categoryMatch)d.counts.categoryMatches++;else reject(d,'category',p.category?'Listing category differs from theme.':'Category unknown or ambiguous; not a confirmed mismatch.');if(categoryMatch){if(p.price!==null&&p.currency==='INR'&&p.price>=category.min&&p.price<=category.max){d.counts.budgetMatches++;if(p.match==='exact'){d.counts.variantMatches++;if(p.images.some(i=>i.permission==='permitted'&&i.variant===p.variant)){d.counts.usablePhotos++;d.counts.packCandidates++}else reject(d,'photos',p.images.length?'Image rights unknown; no export permission.':'No matching product photo available.')}else reject(d,'variant','Exact variant/photo relationship unknown.')}else reject(d,'budget',p.price===null||p.currency===null?'Price/currency unknown.':'Observed price outside hard budget.')}}p.assessment={fit:p.category===category.id&&p.subcategory===slot.subcategory?'Exact selected subcategory':p.category?'Different classified subcategory':'Category unknown or ambiguous',demand:p.evidence.some(e=>e.kind==='video')?'Video description mention; popularity belongs to video, product demand unknown':'No product-specific demand observations',readiness:`Price ${p.price===null?'unknown':'observed'}; stock ${p.stock}; images ${p.images.length?'present, rights checked separately':'missing'}`};this.merge([p])}
 for(const p of this.state.products.filter(p=>!p.observedAt&&p.evidence.some(e=>e.kind==='import')).slice(0,20)){try{const permitted=providers.find(x=>x.status.id===p.retailer&&x.details);const verified=await(permitted?.details?permitted.details(p,signal):listingDetails(p,signal));classify(verified,this.state.settings.categories);this.merge([verified])}catch(e){signal.throwIfAborted();p.failures.push((e as Error).message)}}
 signal.throwIfAborted();let advice:PackAdvice|null=null;if(this.state.settings.ai?.provider!=='none'&&this.state.products.some(p=>p.title&&p.price!==null&&p.currency==='INR'&&p.observedAt&&p.match==='exact'&&p.stock!=='out-of-stock')){if(!this.reasoning)throw new Error('Antigravity account reasoning is not connected. Select Code only explicitly or test account connection.');this.state.job.message='Classifying supplied evidence with Antigravity; collection tools unavailable.';try{advice=await this.reasoning(this.state,slot,signal)}catch(e){throw new Error('Antigravity reasoning paused: '+(e as Error).message)}}signal.throwIfAborted();const pack=assemble(this.state,slot,advice?.selection.map(p=>p.id));if(advice)pack.ai=advice;pack.reasons.push(...errors);await this.repository.save(this.state)
 }
 this.state.job={state:'idle',message:'Prepared queue. No hard filters were relaxed.',dueAt:new Date(Date.now()+6*3600000).toISOString(),attempts:0}
 }catch(e){const attempts=/Antigravity/i.test((e as Error).message)?3:this.state.job.attempts+1;this.state.job={state:abort.signal.aborted?'cancelled':'error',message:(e as Error).message+(attempts>=3?' Automatic retries paused after three failures. Generate manually after fixing setup.':''),dueAt:new Date(Date.now()+Math.min(24,2**Math.min(attempts,5))*3600000).toISOString(),attempts}}finally{await this.repository.save(this.state).catch(e=>{this.state.job.state='error';this.state.job.message='Could not persist job: '+(e as Error).message})}}
 async import(text:string){await this.mutate(async()=>this.merge(importProducts(text,this.state.settings.categories)))}
 async settings(value:unknown){await this.mutate(async()=>{this.state.settings=validateSettings(value);for(const slot of this.state.plan){const c=this.state.settings.categories.find(c=>c.id===slot.category);if(slot.state==='pending'||slot.state==='deferred'){slot.state=!c||c.deferred?'deferred':'pending';slot.reason=!c?'Category removed':c.deferred;if(c&&!c.subcategories.includes(slot.subcategory))slot.subcategory=c.subcategories[(slot.week-1)%c.subcategories.length]}}})}
 async replace(id:string,productId:string){await this.mutate(async()=>{const pack=this.pack(id);if(!['drafted','exported'].includes(pack.state))throw new Error('Only unconsumed packs can change.');const index=pack.productIds.indexOf(productId);if(index<0)throw new Error('Product not in pack.');const alternatives=selectProducts(this.state.products.filter(p=>eligible(p,pack,this.state,new Set(pack.productIds))),30);const current=this.state.products.filter(p=>pack.productIds.includes(p.id)&&p.id!==productId);const chosen=alternatives.find(p=>selectProducts([...current,p],current.length+1).length===current.length+1);if(!chosen)throw new Error('No same-theme alternative meets filters and cooldown. Import or collect more products.');const old=this.state.products.find(p=>p.id===productId)!;old.state='skipped';chosen.state='drafted';chosen.lastUsedAt=new Date().toISOString();pack.productIds[index]=chosen.id;pack.state='drafted';pack.reasons.push('Product replaced with a same-subcategory alternative; prior export is superseded.')})}
 async skip(id:string){await this.mutate(async()=>{const p=this.pack(id);if(p.state==='posted')throw new Error('Posted packs cannot be skipped.');p.state='skipped';this.state.plan.find(s=>s.id===p.slotId)!.state='skipped';p.productIds.forEach(id=>{this.state.products.find(p=>p.id===id)!.state='skipped'})})}
 async feedback(id:string,value:unknown,posted=false){await this.mutate(async()=>{const r=value as Performance;if(!r||typeof r.source!=='string'||!r.source.trim()||typeof r.window!=='string'||!r.window.trim()||!Number.isFinite(Date.parse(r.observedAt))||!Number.isFinite(Date.parse(r.publishedAt)))throw new Error('Provide publication date, metric source, observation time and time window.');if(r.postUrl){const url=new URL(publicHttps(r.postUrl));if(!/(^|\.)instagram\.com$/.test(url.hostname)||!/^\/(p|reel)\//.test(url.pathname))throw new Error('Use an Instagram post/reel URL.')}for(const key of ['reach','saves','shares','clicks','orders','commission'] as const)if(r[key]!==null&&(!Number.isFinite(r[key])||r[key]!<0))throw new Error('Metrics must be nonnegative numbers or null.');const p=this.pack(id);p.performance.push(structuredClone(r));if(posted){p.state='posted';p.productIds.forEach(id=>{this.state.products.find(p=>p.id===id)!.state='posted'})}})}
 async refresh(id:string){await this.mutate(async()=>{await this.revalidate(this.pack(id))})}
 async revalidate(pack:ReadyPack){const providers=await this.providers();for(const id of pack.productIds){const p=this.state.products.find(p=>p.id===id)!;if(p.observedAt&&Date.now()-Date.parse(p.observedAt)<6*3600000)continue;try{const provider=providers.find(x=>x.status.id===p.retailer&&x.details);const next=await(provider?.details?provider.details(p,AbortSignal.timeout(25000)):listingDetails(p,AbortSignal.timeout(25000)));classify(next,this.state.settings.categories);applyLicences(next,this.state.licences??[]);this.merge([next])}catch(e){p.failures.push('Revalidation failed: '+(e as Error).message)}}}
}
